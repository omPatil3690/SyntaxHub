# --- Database / cache ---
DATABASE_URL=postgresql+psycopg://syntaxhub:syntaxhub@localhost:5432/syntaxhub
REDIS_URL=redis://localhost:6379/0

# --- Embeddings (Phase 1/2) ---
# "fake"   = deterministic, offline, zero cost — safe default for dev/testing
# "openai" = real embeddings, needs OPENAI_API_KEY + network
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
OPENAI_API_KEY=

# --- LLM router (Phase 8) ---
# "template" = deterministic patch engine, zero API key needed, covers:
#              middleware->proxy, ReactDOM.render, ReactDOM.hydrate
# "openai"   = falls through to a real LLM for every other API change
LLM_PROVIDER=template
CHEAP_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o

# --- Repository scanning (Phase 5) ---
CLONE_DIR=/tmp/syntaxhub_repos
MAX_FILES_SCANNED=3000

# --- Verification (Phase 9) ---
# "local"  = runs npm/node directly on this host — what the test suite uses
# "docker" = isolated container per run — needs Docker installed
VERIFICATION_BACKEND=local
MAX_REPAIR_ATTEMPTS=3

# --- GitHub integration (Phase 10) ---
# Required only once you register a real GitHub App — see README
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=

# --- Frontend (apps/web) ---
SYNTAXHUB_API_URL=http://localhost:8000
